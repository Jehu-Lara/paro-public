table 'public fact_downtime_event'
	lineageTag: 3545034b-dc67-411d-891e-7852e311a3c9

	measure Total_Segundos_Paro = SUM('public fact_downtime_event'[duration_seconds])
		formatString: 0
		lineageTag: 5940a97a-49bb-4943-9f2c-2ebb57ab964b

	measure Total_Eventos_Paro = COUNTROWS('public fact_downtime_event')
		formatString: 0

	measure Total_Horas_Paro = DIVIDE([Total_Segundos_Paro], 3600)
		formatString: 0.00

	measure %_Pareto_Acumulado = ```
			
			VAR Total_Global = CALCULATE([Total_Segundos_Paro], ALL('public fact_downtime_event'[reason_name]))
			VAR Total_Actual = [Total_Segundos_Paro]
			VAR Acumulado = 
			    CALCULATE(
			        [Total_Segundos_Paro],
			        FILTER(
			            ALL('public fact_downtime_event'[reason_name]),
			            [Total_Segundos_Paro] >= Total_Actual
			        )
			    )
			RETURN
			    DIVIDE(Acumulado, Total_Global, 0)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e69ec2f2-5b9b-445f-86c0-fe612c7448a6

