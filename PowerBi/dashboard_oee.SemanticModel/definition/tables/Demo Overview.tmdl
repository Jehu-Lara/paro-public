	partition 'Demo Overview' = m
		mode: import
		source =
				let
				    Source = Json.Document(Web.Contents("https://paro-public.onrender.com", [RelativePath = "api/v1/demo/overview"])),
				    Line = Source[line],
				    Window = Source[window],
				    ToNumber = (value as any) as nullable number => if value = null then null else Number.FromText(Text.From(value), "en-US"),
				    Result = #table(
				        type table [generated_at=datetimezone, data_through=datetimezone, freshness=text, line_code=text, line_name=text, shift=text, window_start=datetimezone, window_end=datetimezone, availability=nullable number, performance_raw=nullable number, performance_capped=nullable number, quality=nullable number, oee=nullable number, total_count=Int64.Type, good_count=Int64.Type, rejected_count=Int64.Type, downtime_line_seconds=Int64.Type, downtime_logged_event_seconds=Int64.Type, warnings=text],
				        {{DateTimeZone.FromText(Source[generated_at]), DateTimeZone.FromText(Source[data_through]), Source[freshness], Line[code], Line[name], Window[shift], DateTimeZone.FromText(Window[start]), DateTimeZone.FromText(Window[end]), ToNumber(Source[availability]), ToNumber(Source[performance_raw]), ToNumber(Source[performance_capped]), ToNumber(Source[quality]), ToNumber(Source[oee]), Int64.From(Source[total_count]), Int64.From(Source[good_count]), Int64.From(Source[rejected_count]), Int64.From(Source[downtime_line_seconds]), Int64.From(Source[downtime_logged_event_seconds]), if List.IsEmpty(Source[warnings]) then "None" else Text.Combine(List.Transform(Source[warnings], each Text.From(_)), ", ")}}
				    )
				in
				    Result

	annotation PBI_ResultType = Table
