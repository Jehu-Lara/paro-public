model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-MX
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["public production_record","public fact_downtime_event"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'public production_record'
ref table Calendario
ref table 'public fact_downtime_event'

ref cultureInfo en-US

