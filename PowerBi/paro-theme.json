{
    "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.143.json",
    "name": "PARO",
    "dataColors": ["#5B7C99", "#B0805A", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#4a3aa7", "#e34948"],
    "firstLevelElements": "#262624",
    "secondLevelElements": "#6B6B65",
    "thirdLevelElements": "#E4E3DE",
    "fourthLevelElements": "#6B6B65",
    "background": "#FFFFFF",
    "secondaryBackground": "#E4E3DE",
    "tableAccent": "#5B7C99",
    "textClasses": {
        "callout": { "fontSize": 28, "color": "#262624" },
        "title": { "color": "#262624" },
        "header": { "color": "#262624" },
        "label": { "color": "#262624" }
    },
    "visualStyles": {
        "page": {
            "*": {
                "background": [{ "color": { "solid": { "color": "#F7F7F5" } }, "transparency": 0 }]
            }
        },
        "card": {
            "*": {
                "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } } }],
                "border": [{ "show": true, "color": { "solid": { "color": "#E4E3DE" } }, "radius": 4 }],
                "dropShadow": [{ "show": false }]
            }
        },
        "*": {
            "*": {
                "categoryAxis": [{ "gridLineColor": { "solid": { "color": "#E4E3DE" } }, "gridLineThickness": 1 }],
                "valueAxis": [{ "gridLineColor": { "solid": { "color": "#E4E3DE" } }, "gridLineThickness": 1 }]
            }
        }
    }
}
