# Copia este archivo a .env y ajusta los valores locales.
# .env esta ignorado por Git: nunca escribas credenciales reales aqui.

# Metadatos de la aplicacion
PARO_APP_NAME=paro
PARO_ENV=local

# Conexion a la base de datos.
#
# Hoy (S2a): SQLite local, pivote temporal documentado en
# docs/adr/0002-sqlite-temporary-due-to-virtualization-block.md porque el
# entorno de desarrollo no tiene Docker local disponible.
PARO_DATABASE_URL=sqlite:///./paro.db

# Destino (cuando Docker este disponible): PostgreSQL.
# Formato: postgresql+psycopg://usuario:password@host:puerto/base
# PARO_DATABASE_URL=postgresql+psycopg://paro:paro@localhost:5432/paro

# Base separada para las pruebas de integracion contra PostgreSQL. En CI la fija
# el job `integration-postgres` (ver ADR 0003); localmente es opcional.
# PARO_TEST_POSTGRES_URL=postgresql+psycopg://paro:paro@localhost:5432/paro_test

# Zona horaria por defecto para presentacion. El almacenamiento es siempre UTC.
PARO_DEFAULT_TIMEZONE=America/Monterrey

# Token de exencion del rate limiter para clientes de confianza (p. ej. el
# simulador). Unset por defecto: sin esta variable no existe exencion
# posible. Si se configura, las requests que envien el header
# X-Paro-Trusted-Ingest con este mismo valor no cuentan contra el limite de
# 30/minute en los endpoints de escritura. Ver docs/simulator-spec.md seccion 6.
# PARO_TRUSTED_INGEST_TOKEN=

# API key opcional para los endpoints de escritura (POST/PATCH). Unset por
# defecto: sin esta variable, esos endpoints quedan exactamente como estan
# hoy (sin auth) -- incluido el demo publico. Si se configura, cada request
# de escritura debe enviar el header X-API-Key con este mismo valor o recibe
# 401. Ver docs/adr/0005-optional-api-key-authentication.md.
# PARO_API_KEY=
